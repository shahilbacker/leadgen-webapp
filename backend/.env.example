# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT Authentication
JWT_ACCESS_SECRET=super_secret_access_jwt_key_2026_devorae
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_2026_devorae
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supabase PostgreSQL Connection
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key

# MongoDB Connection (for Audit / Analytics Logging)
# When running with Docker Compose, use: mongodb://mongo:27017/leadgen_audit
MONGODB_URI=mongodb://127.0.0.1:27017/leadgen_audit

# Nodemailer SMTP Configuration
# Free options: Gmail App Password, Resend SMTP (smtp.resend.com), or Ethereal for testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Devorae Lead Engine" <notifications@devorae.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com
